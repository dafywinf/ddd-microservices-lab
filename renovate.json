{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "Europe/London",
  "labels": ["dependencies"],
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Major updates wait in the Dependency Dashboard until approved there",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Java: the JDK in CI and the runtime image move together, and only to LTS releases (every 2 years: 25, 29, 33...). The poms' java.version and the Jenkinsfile image suffix are changed by hand",
      "matchDepNames": ["java-jdk", "eclipse-temurin"],
      "groupName": "Java",
      "allowedVersions": "/^(25|29|33|37)(\\D|$)/"
    }
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)platform/[^/]+\\.ya?ml$/",
      "/(^|/)docker/app\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Agent images in Jenkinsfiles, e.g. image 'maven:3.9.6-eclipse-temurin-21'",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Jenkinsfile$/"],
      "matchStrings": ["image\\s+['\"](?<depName>[^:'\"]+):(?<currentValue>[^'\"]+)['\"]"],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Testcontainers images in TestImages.java, e.g. DockerImageName.parse(\"mongo:9.0.8\")",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)src/test/java/.+/TestImages\\.java$/"],
      "matchStrings": ["DockerImageName\\.parse\\(\"(?<depName>[^:\"]+):(?<currentValue>[^\"]+)\"\\)"],
      "datasourceTemplate": "docker"
    }
  ]
}
